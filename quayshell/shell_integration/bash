# Quayshell Bash integration. The outer login shell loads the login environment.
[[ -r /etc/bash.bashrc ]] && source /etc/bash.bashrc
[[ -r "$HOME/.bashrc" ]] && source "$HOME/.bashrc"

__quayshell_precmd() {
    local status="$?"
    printf '\e]666;vte.ext.quayshell.shell.postexec=%s\e\\' "$status"
    printf '\e]133;D;%s\e\\\e]133;A\e\\' "$status"
    return "$status"
}

if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
    PROMPT_COMMAND=(__quayshell_precmd "${PROMPT_COMMAND[@]}")
else
    PROMPT_COMMAND="__quayshell_precmd${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

PS0='\e]666;vte.ext.quayshell.shell.preexec!\e\\\e]133;C\e\\\r'"${PS0:-}"
PS1="${PS1}"'\[\e]133;B\e\\\]'
